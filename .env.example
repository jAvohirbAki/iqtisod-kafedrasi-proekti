# PostgreSQL ulanish satri (lokal `npx prisma dev` yoki Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kafedra_db?schema=public"

# Sessiya JWT tokenini imzolash uchun maxfiy kalit (kamida 32 ta belgi)
AUTH_SECRET="kafedra-portal-super-secret-change-in-production-2026"

# Yuklanadigan fayllar uchun maksimal hajm (baytlarda, 20MB)
MAX_UPLOAD_BYTES=20971520
