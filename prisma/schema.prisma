generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEAN
  TEACHER
  STUDENT
}

enum ControlType {
  JORIY
  ORALIQ
  MUSTAQIL
  LAB
  YAKUNIY
}

enum SubmissionStatus {
  SUBMITTED
  RESUBMITTED
  GRADED
  RETURNED
  IN_REVIEW
}

enum KpiBlock {
  SCIENTIFIC
  METHODICAL
  INNOVATION
  QUALITY
}

enum KpiStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT_CREATED
  SUBMISSION_RECEIVED
  SUBMISSION_GRADED
  SUBMISSION_RETURNED
  KPI_SUBMITTED
  KPI_REVIEWED
  SYSTEM_ALERT
  SYSTEM
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum IssueSource {
  API_SERVER
  DATABASE
  CLIENT_UI
  HEALTH_CHECK
  AUTH
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

model Department {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  faculty   String
  headName  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  groups    AcademicGroup[]
  subjects  Subject[]
}

model AcademicGroup {
  id           String           @id @default(cuid())
  name         String           @unique
  courseYear   Int
  semester     Int
  specialty    String
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students     User[]
  assignments  Assignment[]
  teachings    SubjectTeacher[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  fullName          String
  role              Role
  phone             String?
  academicTitle     String?
  isActive          Boolean          @default(true)
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  groupId           String?
  group             AcademicGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teachings         SubjectTeacher[]
  createdAssignments Assignment[]    @relation("TeacherAssignments")
  submissions       Submission[]     @relation("StudentSubmissions")
  gradedSubmissions Submission[]     @relation("GradedBy")
  submissionGrades  SubmissionGrade[]
  kpiEntries        KpiEntry[]       @relation("TeacherKpis")
  reviewedKpis      KpiEntry[]       @relation("ReviewedBy")
  auditLogs         AuditLog[]       @relation("ActorLogs")
  notifications     Notification[]
  reportedIssues    SystemIssue[]    @relation("ReportedIssues")
  resolvedIssues    SystemIssue[]    @relation("ResolvedIssues")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([role])
  @@index([departmentId])
  @@index([groupId])
}

model Subject {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique
  credits      Int              @default(6)
  semester     Int              @default(1)
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teachings    SubjectTeacher[]
  assignments  Assignment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SubjectTeacher {
  id        String        @id @default(cuid())
  subjectId String
  teacherId String
  groupId   String
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group     AcademicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([subjectId, teacherId, groupId])
}

model Assignment {
  id             String        @id @default(cuid())
  title          String
  description    String
  controlType    ControlType   @default(JORIY)
  maxScore       Int           @default(20)
  dueDate        DateTime
  allowLate      Boolean       @default(true)
  latePenaltyPct Int           @default(10)
  attachmentName String?
  attachmentPath String?
  attachment     AssignmentAttachment?
  subjectId      String
  groupId        String
  teacherId      String
  publishRequestId String?
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group          AcademicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher        User          @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions    Submission[]
  notifications  Notification[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
  @@unique([teacherId, publishRequestId])
}

model AssignmentAttachment {
  assignmentId String     @id
  content      Bytes
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String              @id @default(cuid())
  assignmentId String
  studentId   String
  version     Int                 @default(1)
  comment     String?
  externalUrl String?
  fileName    String?
  filePath    String?
  fileSize    Int?
  isLate      Boolean             @default(false)
  status      SubmissionStatus    @default(SUBMITTED)
  score       Float?
  feedback    String?
  gradedById  String?
  submittedAt DateTime            @default(now())
  gradedAt    DateTime?
  gradingRevision Int             @default(0)
  assignment  Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User                @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy    User?               @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  versions    SubmissionVersion[]
  files       SubmissionFile[]
  grades      SubmissionGrade[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([assignmentId, studentId])
  @@index([status])
}

model SubmissionVersion {
  id           String     @id @default(cuid())
  submissionId String
  version      Int
  requestId    String?
  comment      String?
  externalUrl  String?
  fileName     String?
  filePath     String?
  fileSize     Int?
  isLate       Boolean    @default(false)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([submissionId])
  @@unique([submissionId, requestId])
}

model SubmissionFile {
  path         String     @id
  submissionId String
  name         String
  mimeType     String
  size         Int
  content      Bytes
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionGrade {
  id                 String           @id @default(cuid())
  submissionId       String
  submissionVersion  Int
  revision           Int
  status             SubmissionStatus
  score              Float?
  rawScore           Float?
  appliedLatePenalty Boolean?
  feedback           String?
  graderId           String?
  gradedAt           DateTime         @default(now())
  submission         Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader             User?            @relation(fields: [graderId], references: [id], onDelete: SetNull)

  @@unique([submissionId, revision])
}

model KpiCriterion {
  id            String     @id @default(cuid())
  code          String     @unique
  title         String
  block         KpiBlock
  pointsPerUnit Float
  maxPoints     Float?
  description   String
  requiresProof Boolean    @default(true)
  isActive      Boolean    @default(true)
  entries       KpiEntry[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model KpiEntry {
  id              String       @id @default(cuid())
  teacherId       String
  criterionId     String
  academicYear    String       @default("2026-2027")
  semester        String       @default("Kuzgi")
  title           String
  description     String?
  quantity        Int          @default(1)
  calculatedScore Float
  approvedScore   Float?
  proofUrl        String?
  proofFileName   String?
  proofFilePath   String?
  status          KpiStatus    @default(PENDING)
  reviewComment   String?
  reviewedById    String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  teacher         User         @relation("TeacherKpis", fields: [teacherId], references: [id], onDelete: Cascade)
  criterion       KpiCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  reviewedBy      User?        @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([academicYear])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  reason     String?
  actor      User     @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  assignmentId String?
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt, id])
  @@index([assignmentId])
}

model SystemIssue {
  id               String        @id @default(cuid())
  title            String
  message          String
  severity         IssueSeverity @default(ERROR)
  source           IssueSource   @default(API_SERVER)
  status           IssueStatus   @default(OPEN)
  route            String?
  method           String?
  statusCode       Int?
  stackTrace       String?
  metadata         String?
  fingerprint      String
  occurrenceCount  Int           @default(1)
  lastOccurredAt   DateTime      @default(now())
  reportedByUserId String?
  resolvedById     String?
  resolutionNote   String?
  resolvedAt       DateTime?
  reportedBy       User?         @relation("ReportedIssues", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  resolvedBy       User?         @relation("ResolvedIssues", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([severity])
  @@index([fingerprint])
  @@index([lastOccurredAt])
}
